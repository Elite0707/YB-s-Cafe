# Required at first setup. Generate a long random value and share it only with the cafe owner.
SETUP_KEY=replace-with-a-long-random-secret

# Local persistence. For production, mount a durable volume at this path and back it up regularly.
DATABASE_PATH=./data/cafe.sqlite
# Optional durable uploads directory for menu/cafe raster images; defaults beside DATABASE_PATH.
# UPLOADS_PATH=./data/uploads
SESSION_SECRET=replace-with-at-least-32-random-bytes
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:5173
# Optional comma-separated browser-origin allowlist when the public request host is not forwarded to the API.
# APP_ORIGIN=https://cafe.example.com,https://admin.example.com
# Set only when behind a known proxy. Accepts a trusted hop count or comma-separated CIDRs.
# TRUST_PROXY=1
# Optional: trusted reverse proxy hop count or comma-separated IP/CIDR list. Leave empty when not behind a proxy.
TRUST_PROXY=

# Optional Stripe Checkout. Cash at counter/table remains available without these values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
