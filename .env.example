# Required at first setup. Generate a long random value and share it only with the cafe owner.
SETUP_KEY=replace-with-a-long-random-secret

# PostgreSQL connection for the local PostgreSQL server and cafe_dev database.
DATABASE_URL=postgresql://postgres:replace-with-your-local-password@localhost:5432/cafe_dev
# Optional: set to "disable" only for a local PostgreSQL server without TLS.
# DATABASE_SSL=disable
# Optional durable uploads directory for menu/cafe raster images.
# UPLOADS_PATH=./data/uploads
# Optional Neon Object Storage bucket. Leave the AWS_* values unset to use local uploads.
NEON_STORAGE_BUCKET=cafe-menu-images
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=ap-southeast-1
# Netlify reserves AWS_*; use these aliases as Netlify environment variable names instead.
# NEON_S3_ACCESS_KEY_ID=
# NEON_S3_SECRET_ACCESS_KEY=
# NEON_S3_ENDPOINT=
# NEON_S3_REGION=ap-southeast-1
SESSION_SECRET=replace-with-at-least-32-random-bytes
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:5173
# Optional comma-separated browser-origin allowlist when the public request host is not forwarded to the API.
# APP_ORIGIN=https://cafe.example.com,https://admin.example.com
# Set only when behind a known proxy. Accepts a trusted hop count or comma-separated CIDRs.
# TRUST_PROXY=1
# Optional: trusted reverse proxy hop count or comma-separated IP/CIDR list. Leave empty when not behind a proxy.
TRUST_PROXY=

# Optional Stripe Checkout. Cash at counter/table remains available without these values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
